<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Torreox</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; font-family:'Inter', sans-serif; }

body {
  background: url('background.png') no-repeat center center fixed;
  background-size: cover;
  color:#000;
  line-height:1.6;
  display:flex;
  flex-direction:column;
  min-height:100vh;
}

header {
  display:flex;
  align-items:center;
  padding:0.8rem 1rem;
  position:sticky;
  top:0;
  background-color:#fff;
  z-index:10;
  border-bottom:1px solid #e0e0e0;
}

header img { 
  height:50px; 
  margin-left:0;
}

main {
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:4rem 1rem 2rem 1rem;
  flex:1;
  text-align:center;
}

.title-section {
  max-width:800px;
  width:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  margin-bottom:2rem;
}

.title-section h1 {
  font-size:1.6rem;
  font-weight:700;
  margin-bottom:1rem;
  letter-spacing:0.5px;
  line-height:1.1;
}

.search-container {
  display:flex;
  width:100%;
  max-width:380px;
  justify-content:center;
  gap:0.5rem;
}

.search-container input[type="text"] {
  flex:1;
  border-radius:20px;
  padding:0.6rem 1rem;
  font-size:0.9rem;
  border:1px solid #ccc;
  outline:none;
  background-color:#fff;
  height:40px;
}

.search-container button {
  border-radius:20px;
  border:1px solid #ccc;
  padding:0.6rem 1rem;
  font-size:0.9rem;
  background-color:#f5f5f5;
  cursor:pointer;
  font-weight:600;
  color:#000;
  transition:0.2s;
  height:40px;
}

.search-container button:hover { opacity:0.7; }

/* SEPARATOR */
.separator {
  width:90%;
  max-width:900px;
  height:2px;
  background:#e0e0e0;
  margin:0.8rem auto; /* MODIFICA: ancora più in alto */
  opacity:0.3;
}

/* MISSION */
.mission {
  max-width:750px;
  padding:0 1rem;
}

.mission h2 {
  font-size:1.8rem;
  font-weight:600;
  margin-bottom:1rem;
}

.mission-divider {
  width:60px;
  height:2px;
  background:#000;
  margin:0 auto 1rem auto;
  opacity:0.2;
}

.mission p {
  font-size:1rem;
  line-height:1.6;
  color:#222;
}

/* INSPECTIONS */
.inspection {
  max-width:700px;
  margin-top:4rem;
  padding:2rem;
  background-color:#fff;
  border-radius:6px;
  text-align:left;
  width:100%;
}

.inspection h2 {
  font-size:1.6rem;
  margin-bottom:1.5rem;
  font-weight:600;
  text-align:center;
}

.inspection-list {
  list-style:none;
  display:flex;
  flex-direction:column;
  gap:1rem;
}

.inspection-list .content {
  background-color:#f5f5f5;
  padding:1rem 1.2rem;
  border-radius:4px;
}

/* RESULTS BOX */
.results {
  width:100%;
  max-width:500px;
  display:flex;
  flex-direction:column;
  gap:1rem;
  margin-top:2rem;
}

.studio {
  background-color:rgba(255,255,255,0.9);
  padding:1rem 1.2rem;
  border:1px solid #ccc;
  border-radius:8px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
}

.studio span {
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.studio button {
  padding:0.4rem 0.8rem;
  border:none;
  border-radius:20px;
  background-color:#ccc;
  cursor:pointer;
  font-weight:600;
  transition:0.2s;
  color:#000;
}

.studio button:hover { background-color:#bbb; }

footer {
  background-color:rgba(255,255,255,0.9);
  color:#6c757d;
  text-align:center;
  padding:2rem 1rem;
  border-top:1px solid #e0e0e0;
  font-size:0.9rem;
}

@media(max-width:600px){
  .search-container {
    flex-direction:column;
    gap:0.5rem;
  }
  .search-container input,
  .search-container button {
    width:100%;
    border-radius:20px;
    margin-bottom:0.5rem;
  }
}
</style>
</head>
<body>

<header>
  <img src="logo.png" alt="Logo Torreox">
</header>

<main>

  <div class="title-section">
    <h1>Trova uno studio dentistico<br>certificato Torreox</h1>

    <div class="search-container">
      <input type="text" id="searchInput" placeholder="Cerca per città...">
      <button type="button" onclick="cercaStudio()">Cerca</button>
    </div>

    <div class="results" id="results"></div>
  </div>

  <div class="separator"></div>

  <!-- MISSION -->
  <div class="mission">
    <h2>La nostra missione</h2>
    <div class="mission-divider"></div>
    <p>
      La nostra missione è aiutare le persone a trovare studi dentistici accuratamente selezionati. Tutti gli studi nella lista Torreox sono sottoposti a rigorosi test e ispezioni a sorpresa regolari per garantire standard elevati e mantenere la selezione affidabile.
    </p>
  </div>

  <!-- INSPEZIONI -->
  <div class="inspection">
    <h2>Cosa controlliamo con le ispezioni a sorpresa</h2>
    <ul class="inspection-list">
      <li class="content">
        <strong>Pulizia e sterilizzazione</strong>
        <p>Verifichiamo igiene generale dello studio, sterilizzazione strumenti e sanificazione superfici.</p>
      </li>
      <li class="content">
        <strong>Titoli dei medici</strong>
        <p>Controlliamo certificazioni, diplomi e aggiornamenti professionali.</p>
      </li>
      <li class="content">
        <strong>Lavoro e procedure</strong>
        <p>Verifichiamo che diagnosi e trattamenti siano eseguiti correttamente e secondo standard professionali.</p>
      </li>
      <li class="content">
        <strong>Accoglienza</strong>
        <p>Valutiamo professionalità dello staff e gestione del paziente.</p>
      </li>
    </ul>
  </div>

</main>

<footer>
  &copy; 2026 Torreox. Tutti i diritti riservati.
</footer>

<script>
// LISTA STUDI CERTIFICATI + LINK GOOGLE
const studiCertificati = [
  {nome:"Studio Dentistico Rossi", città:"Milano"},
  {nome:"Studio Verdi Dental", città:"Torino"},
  {nome:"Clinica Dentale Neri", città:"Firenze"}
];

function cercaStudio(){
  const input = document.getElementById('searchInput').value.toLowerCase();
  const resultsDiv = document.getElementById('results');
  resultsDiv.innerHTML = '';

  const risultati = studiCertificati.filter(s => s.città.toLowerCase().includes(input));

  if(risultati.length===0){
    resultsDiv.innerHTML='<p style="color:#888;">Nessuno studio trovato</p>';
    return;
  }

  risultati.forEach(s=>{
    const div = document.createElement('div');
    div.className = 'studio';
    div.innerHTML = `
      <span><strong>${s.nome}</strong> - ${s.città}</span>
      <button onclick="window.open('https://www.google.com/search?q=${encodeURIComponent(s.nome + ' ' + s.città)}','_blank')">Vai su Google</button>
    `;
    resultsDiv.appendChild(div);
  });
}
</script>

</body>
</html>